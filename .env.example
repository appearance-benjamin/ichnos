# Copy to .env and fill in what you have. Never share or commit .env.

# Free key with $1/day of credit: https://openalex.org/settings/api
# Without one, every request shares $0.10/day with everyone on your IP address.
OPENALEX_API_KEY=

# Free key, 1 request per second: https://www.semanticscholar.org/product/api#api-key-form
# Without one, requests share a public limit and are retried after HTTP 429.
S2_API_KEY=

# Optional free key for CORE, the aggregator of university repository copies (abstracts and full texts):
# https://core.ac.uk/services/api . Without one, CORE allows about 10 requests a minute, so a run waits longer.
CORE_API_KEY=

# Free key, 10 instead of 3 requests per second for PubMed:
# NCBI account > Account settings > API Key Management
NCBI_API_KEY=

# Optional: given only to the APIs that ask for a contact (Unpaywall, OpenAlex,
# Europe PMC, PubMed), never to other servers. Leave empty to send none.
# Unpaywall answers only callers who give an email, so full-text lookup skips
# Unpaywall while this is empty (Europe PMC and OpenAlex still work).
CONTACT_EMAIL=

# Optional: where GROBID runs (default http://localhost:8070). Without it, PDFs are read with pypdf.
# GROBID_URL=

# Optional: another location for the evidence store (default data/evidence.sqlite).
# EVIDENCE_DB=

# Optional: a local model for agent-run, through an OpenAI-compatible server. Ollama serves
# http://localhost:11434/v1 (the default), LM Studio http://localhost:1234/v1, vLLM where you start it.
# LLM_MODEL is the model's name on that server (e.g. qwen3:14b); LLM_API_KEY only if the server was started with one.
# LLM_ENDPOINT=
# LLM_MODEL=
# LLM_API_KEY=

# Optional: your name in the app, so decisions and insight changes are attributed to you.
REVIEWER=

# Optional: your library's proxy prefix, for a "Library" link per record in the full-text list
# (an EZproxy "login?url=" prefix, or a template with {url}). With the library's browser extension the DOI link
# already opens through the library. You sign in yourself in the browser.
# LIBRARY_PROXY=

# Optional: where your browser saves PDFs (default: your Downloads folder). add-pdfs copies the PDFs there that
# match a retained record still without a full text, and changes nothing in that folder. off: look only in
# fulltext/inbox.
# DOWNLOADS_DIR=
